# Convite do grupo (chat.whatsapp.com/...). Vazio usa o grupo padrão.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=
# URL pública desta landing (canonical e Open Graph).
NEXT_PUBLIC_SITE_URL=
# Pixel da Meta. Vazio usa o padrão de src/lib/meta.ts.
NEXT_PUBLIC_META_PIXEL_ID=
# SECRETO: token da API de Conversões. Só servidor, nunca commitar.
META_CAPI_TOKEN=
# Opcional: código de teste do Gerenciador de Eventos.
META_TEST_EVENT_CODE=
# Opcional.
NEXT_PUBLIC_GA_ID=
